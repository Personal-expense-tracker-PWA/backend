PORT=4000
# Postgres connection string. For Neon use ?sslmode=verify-full
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of allowed origins for CORS (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173
